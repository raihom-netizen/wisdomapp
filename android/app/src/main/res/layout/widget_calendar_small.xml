<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_dark"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingVertical="8dp">

    <!-- Cabeçalho: dia grande + dia da semana (estilo Calendários iOS) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/wcs_day_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="4"
            android:textColor="#FFFF8A50"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wcs_weekday"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="SEXTA-FEIRA"
            android:textAllCaps="true"
            android:textColor="#CCFFFFFF"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Evento 1 — hoje -->
    <LinearLayout
        android:id="@+id/wcs_ev1_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/widget_pill_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:paddingVertical="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/wcs_ev1_bar"
            android:layout_width="3dp"
            android:layout_height="24dp"
            android:background="#FF2563EB" />

        <TextView
            android:id="@+id/wcs_ev1_sy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="🚔"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/wcs_ev1_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Plantão"
                android:textAllCaps="true"
                android:textColor="#FFFFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wcs_ev1_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="06:00-18:00"
                android:textAllCaps="true"
                android:textColor="#99FFFFFF"
                android:textSize="8sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Evento 2 — hoje -->
    <LinearLayout
        android:id="@+id/wcs_ev2_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:background="@drawable/widget_pill_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:paddingVertical="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/wcs_ev2_bar"
            android:layout_width="3dp"
            android:layout_height="24dp"
            android:background="#FF12B5A5" />

        <TextView
            android:id="@+id/wcs_ev2_sy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="⚖️"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/wcs_ev2_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Audiência"
                android:textColor="#FFFFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wcs_ev2_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="08:15-09:15"
                android:textColor="#99FFFFFF"
                android:textSize="8sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Amanhã -->
    <TextView
        android:id="@+id/wcs_tomorrow_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="AMANHÃ"
        android:textAllCaps="true"
        android:textColor="#FFEF5350"
        android:textSize="9sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/wcs_tomorrow_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="@drawable/widget_pill_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:paddingVertical="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/wcs_tomorrow_bar"
            android:layout_width="3dp"
            android:layout_height="22dp"
            android:background="#FF2563EB" />

        <TextView
            android:id="@+id/wcs_tomorrow_sy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="📅"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/wcs_tomorrow_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Compromisso"
            android:textColor="#FFFFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Finance item 1 -->
    <LinearLayout
        android:id="@+id/wcs_fi1_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:background="#22FF8A50"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:paddingVertical="3dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/wcs_fi1_bar"
            android:layout_width="3dp"
            android:layout_height="20dp"
            android:background="#FFFF5252" />

        <TextView
            android:id="@+id/wcs_fi1_sy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="📉"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/wcs_fi1_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="DESPESAS"
            android:textAllCaps="true"
            android:textColor="#FFFFCCBC"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Finance item 2 -->
    <LinearLayout
        android:id="@+id/wcs_fi2_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="#22FF8A50"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:paddingVertical="3dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/wcs_fi2_bar"
            android:layout_width="3dp"
            android:layout_height="20dp"
            android:background="#FF4CAF50" />

        <TextView
            android:id="@+id/wcs_fi2_sy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="📈"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/wcs_fi2_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="RECEITAS"
            android:textAllCaps="true"
            android:textColor="#FFFFCCBC"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/wcs_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Sem compromissos hoje"
        android:textAllCaps="true"
        android:textColor="#88FFFFFF"
        android:textSize="9sp"
        android:visibility="gone" />
</LinearLayout>
