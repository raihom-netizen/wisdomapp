<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Biometria/digital: necessário para reconhecer e usar digital ou facial no APK. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <!-- Android 13+ (API 33+): necessário para exibir notificações locais (lembretes de plantão) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Câmara: comprovantes financeiros (tirar foto) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Galeria: o app usa o SELETOR DE FOTOS DO SISTEMA (image_picker/file_picker),
         que não precisa de permissão. Política do Play (02/10/2026): sem READ_MEDIA_*;
         tools:node="remove" impede que algum plugin as traga de volta no merge. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" tools:node="remove" />
    <!-- Android 12 e anteriores -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <!-- Exigido pelo Play Console quando o app declara uso de ID de publicidade (ex.: analytics). tools:merge evita remoção por dependências. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="merge" />
    <!-- Widgets: alarme meia-noite / meio-dia + boot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" tools:ignore="ExactAlarm" />
    <!-- Despertador: o app acorda para desenhar o alarme (botões Adiar/Encerrar)
         quando o push chega com o aparelho em repouso. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- «Bloquear chamadas de desconhecidos» (Configurações, só Android 10+): saber se
         quem liga está salvo nos contatos. Função principal que exige a agenda inteira —
         precisa da declaração «Permissões de contato» no Play Console (prazo 27/01/2027). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:extractNativeLibs="false">
        <!-- Android: evita jank em aparelhos com Vulkan/Impeller instável no Flutter atual. -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />
        <!-- adjustResize: área útil encolhe com o IME (Flutter). Sem stateHidden para reduzir casos em que o sistema demora a mostrar o teclado ao focar campo. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Canal padrão FCM (lembretes de agenda) — alinhado a scale_notifications_service_io -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="controletotal_escala" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />
        <receiver
            android:name=".ControleTotalWidgetProvider"
            android:label="@string/widget_scales_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/home_widget_controle_total" />
        </receiver>
        <receiver
            android:name=".ControleTotalWidgetSmallProvider"
            android:label="@string/widget_calendar_small_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/home_widget_controle_total_small" />
        </receiver>
        <receiver
            android:name=".ControleTotalWidgetMediumProvider"
            android:label="@string/widget_calendar_medium_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/home_widget_controle_total_medium" />
        </receiver>
        <service
            android:name=".ControleTotalWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
        <receiver
            android:name=".WidgetSyncAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="com.wisdomapp.app.WIDGET_SYNC_ALARM" />
            </intent-filter>
        </receiver>
        <!-- Configurações → «Bloquear chamadas de desconhecidos» (Android 10+).
             Só é acionado quando o usuário escolhe o app como triagem de chamadas
             (RoleManager.ROLE_CALL_SCREENING). Recebe apenas o NÚMERO de quem
             liga; não usa READ_CALL_LOG nem READ_PHONE_STATE (Play Policy). -->
        <service
            android:name=".CallBlockScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE"
            tools:targetApi="q">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>
        <!-- Botões da notificação do despertador («Adiar 3/5 min», «Encerrar»):
             o flutter_local_notifications só entrega a ação com este receiver. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver" />
        <!-- Lembretes LOCAIS agendados (zonedSchedule em scale_notifications_service_io):
             sem estes dois receivers o alarme do Android dispara para uma classe não
             declarada e a notificação nunca aparece; o de boot reagenda após reiniciar
             o aparelho ou atualizar o app (README do flutter_local_notifications). -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <!-- Android 11+ (API 30+): necessário para canLaunchUrl/launchUrl funcionar com http/https (ex.: Links Úteis no módulo Minhas Anotações). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
    </queries>
</manifest>
