<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.wisdomapp.widget</string>
	</array>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<key>aps-environment</key>
	<string>production</string>
	<!-- Despertador e lembretes de compromisso chegam como "time-sensitive":
	     aparecem na tela mesmo com o iPhone no silencioso ou em Foco. O servidor
	     envia esse nível no push; sem este entitlement o iOS ignora. O CI ativa a
	     capability no App ID (scripts/codemagic_ios_enable_time_sensitive.py) e,
	     se o perfil não tiver, remove a chave só naquele build. -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
</dict>
</plist>
